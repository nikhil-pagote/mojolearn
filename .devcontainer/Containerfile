FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git clang \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://pixi.sh/install.sh | sh
ENV PATH="/root/.pixi/bin:${PATH}"

RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/root/.local/bin:${PATH}"

# Must match `workspaceFolder` in devcontainer.json (the repo's mount point).
# If these diverge, `pixi install` bakes stale absolute paths into the Mojo/MAX
# config (modular.cfg) and mojo fails with "unable to locate module 'std'".
WORKDIR /workspaces/mojo
