FROM ubuntu:24.04

# Prevents apt/debconf from blocking a build on an interactive prompt (e.g.
# tzdata's "Geographic area:" question, pulled in transitively by ca-certificates).
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git clang \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://pixi.sh/install.sh | sh
ENV PATH="/root/.pixi/bin:${PATH}"

# Node.js: not needed for Mojo itself, but Claude Code MCP plugins launched via
# `npx` (e.g. the context7 plugin: `npx -y @upstash/context7-mcp`) need it —
# without it, `claude mcp list` shows "Failed to connect" (npx: command not found).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/root/.local/bin:${PATH}"

# Must match `workspaceFolder` in devcontainer.json (the repo's mount point).
# If these diverge, `pixi install` bakes stale absolute paths into the Mojo/MAX
# config (modular.cfg) and mojo fails with "unable to locate module 'std'".
WORKDIR /workspaces/mojo

# Point Mojo's Python interop at the env's CPython so a compiled binary run
# directly (`./pyintop`, outside `pixi run`) can load libpython. pixi.toml's
# [activation.env] covers `pixi run`/`pixi shell`; this ENV covers bare shells.
# Literal path: a Dockerfile ENV does not expand $PWD, and it stays valid because
# WORKDIR == workspaceFolder == /workspaces/mojo. libpython3.so is the
# version-agnostic symlink to the bundled CPython.
ENV MOJO_PYTHON_LIBRARY="/workspaces/mojo/.pixi/envs/default/lib/libpython3.so"
